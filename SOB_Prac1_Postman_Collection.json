		{
			"name": "1. Customers (Usuaris)",
			"item": [
				{
					"name": "GET /customer (Llistar usuaris sense contrasenya)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Estat HTTP és 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Retorna un array JSON d'usuaris\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.be.an('array');",
									"    pm.expect(data.length).to.be.at.least(1);",
									"});",
									"pm.test(\"Seguretat: cap usuari exposa la contrasenya (pass)\", function () {",
									"    var data = pm.response.json();",
									"    data.forEach(function(u) {",
									"        pm.expect(u).to.not.have.property('pass');",
									"        pm.expect(u).to.not.have.property('password');",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/customer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"customer"
							]
						}
					}
				},
				{
					"name": "GET /customer/1 (Detall d'usuari amb enllaços HATEOAS)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Estat HTTP és 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Retorna dades de l'usuari amb enllaços HATEOAS\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.have.property('id');",
									"    pm.expect(data).to.have.property('user');",
									"    pm.expect(data).to.have.property('_links');",
									"});",
									"pm.test(\"Seguretat: no exposa la contrasenya\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.not.have.property('pass');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/customer/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"customer",
								"1"
							]
						}
					}
				},
